# Electron main reads process.env at startup; include the HTTP /api prefix.
# Set this in the launch environment (see README.md).
FTP_API_BASE_URL=http://127.0.0.1:3000/api
# Optional WS/WSS base; omitted means derive from the HTTP origin.
# FTP_WS_BASE_URL=ws://127.0.0.1:3000
# VITE_API_BASE_URL is not read by this implementation.
